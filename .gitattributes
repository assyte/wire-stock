# Normalize line endings for cross-platform development
* text=auto eol=lf

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.prisma text eol=lf

# Binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.lock binary