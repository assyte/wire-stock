# ============================================
# WireStock Environment Variables (EXAMPLE)
# ============================================
# Copy this file to `.env` and fill in your own values.
# DO NOT commit your real `.env` to Git.

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public"
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME
POSTGRES_PORT=5432

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://HOST:6379"
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# JWT (use strong random secrets in production!)
# ============================================
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# APPLICATION
# ============================================
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
BCRYPT_ROUNDS=12

# ============================================
# RATE LIMITING
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ============================================
# MINIO (S3-compatible object storage)
# ============================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=CHANGE_ME

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@wire-stock.local
ENABLE_EMAIL_VERIFICATION=false

# ============================================
# CLIENT (apps/web/.env.local)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=WireStock
NEXT_PUBLIC_APP_URL=http://localhost:3000